{
  "expo": {
    "name": "Field Capture",
    "slug": "sledge-field-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldcapture",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.fieldcapture.app",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.fieldcapture.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Field Capture uses the camera to photograph site conditions for your reports.",
          "photosPermission": "Field Capture lets you attach existing photos to your reports.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Field Capture records voice notes to attach to your reports.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field Capture tags reports with your location so the team knows where an issue was found."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
